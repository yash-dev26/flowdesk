# Copy to .env and fill in. Never commit .env.

# LLM: groq | fake (fake needs no key but every ticket falls back to human review)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_BASE_DELAY_SECONDS=0.5
LLM_MAX_DELAY_SECONDS=8

# Cost estimate, USD per 1M tokens (check Groq's pricing page for your model)
PRICE_PER_1M_INPUT_USD=0.59
PRICE_PER_1M_OUTPUT_USD=0.79

# Retrieval: fastembed (local model, downloads once) | hashing (offline, not semantic)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KB_DIR=kb
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.5

# Shows the "simulate LLM failure" control in the UI
DEMO_MODE=true

DB_PATH=data/flowdesk.db
MAX_MESSAGE_CHARS=4000