# Copy to .env and fill in. 
LLM_PROVIDER=groq            # groq | fake
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_BASE_DELAY_SECONDS=0.5
LLM_MAX_DELAY_SECONDS=8
PRICE_PER_1M_INPUT_USD=0.59
PRICE_PER_1M_OUTPUT_USD=0.79
EMBEDDING_PROVIDER=fastembed   # fastembed | hashing (offline)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KB_DIR=kb
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.5
DB_PATH=data/flowdesk.db
MAX_MESSAGE_CHARS=4000
